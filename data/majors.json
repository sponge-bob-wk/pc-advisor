 "dimensions": {
  "gpu": {
   "label": "显卡",
   "scale": "0 核显 / 1 入门独显（4G 显存）/ 2 中端独显（6-8G）/ 3 高端独显（12G+）",
   "why": "新增维度。原有五维（价格/性能/可加装/品牌/便携）里没有显卡，而专业需求里显卡是第一条硬门槛。"
  },
  "ram": {
   "label": "内存",
   "scale": "8 / 16 / 32 / 64（单位 GB）",
   "why": "新增维度。内存是准大学生四年里最可能不够的一项，且涨内存的年份里它同时决定价格。"
  },
  "storage": {
   "label": "存储",
   "scale": "512 / 1024 / 2048（单位 GB）",
   "why": "新增维度。视频素材与音频采样库的体积差一个数量级，512G 在这两个组里是硬伤，在办公组里完全够用。"
  }
 },
