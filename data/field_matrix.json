  "fields": [
    {
      "key": "cpu",
      "cn": "CPU 型号",
      "unit": "-",
      "where": "详情页参数 / 官网规格页",
      "why": "决定单核与多核能力"
    },
    {
      "key": "cores",
      "cn": "核心数",
      "unit": "核",
      "where": "官网规格页",
      "why": "多核场景的换算依据"
    },
    {
      "key": "ramGB",
      "cn": "内存容量",
      "unit": "GB",
      "where": "详情页参数",
      "why": "最容易被「最高可选」误导的一项"
    },
    {
      "key": "ramType",
      "cn": "内存形态",
      "unit": "板载 / 插槽",
      "where": "官网规格页（LPDDR5X=板载，DDR5 SO-DIMM=插槽）",
      "why": "决定四年后能不能加，比容量更重要"
    },
    {
      "key": "storageGB",
      "cn": "存储容量",
      "unit": "GB",
      "where": "详情页参数",
      "why": "视频素材与采样库吃这个"
    },
    {
      "key": "gpuModel",
      "cn": "显卡型号",
      "unit": "-",
      "where": "详情页参数",
      "why": "只给名字不够，名字不携带性能"
    },
    {
      "key": "vramGB",
      "cn": "显存",
      "unit": "GB",
      "where": "官网规格页",
      "why": "AE 要 4G 起、PR 4K 要 8G、达芬奇 AI 要 16G"
    },
    {
      "key": "tgpW",
      "cn": "显卡功耗",
      "unit": "W",
      "where": "官网参数 / 第三方评测（电商常不写）",
      "why": "同型号 35W–115W 性能差 2.7 倍"
    },
    {
      "key": "screenInch",
      "cn": "屏幕尺寸",
      "unit": "英寸",
      "where": "详情页参数",
      "why": "宿舍桌面与携带的权衡"
    },
    {
      "key": "resolution",
      "cn": "分辨率",
      "unit": "px",
      "where": "详情页参数",
      "why": "看文献、做设计的实际体验"
    },
    {
      "key": "refreshHz",
      "cn": "刷新率",
      "unit": "Hz",
      "where": "详情页参数",
      "why": "游戏与剪辑预览的流畅度"
    },
    {
      "key": "colorGamut",
      "cn": "色域",
      "unit": "sRGB / DCI-P3 / AdobeRGB",
      "where": "官网规格页（电商标题几乎不写）",
      "why": "平面组的真实瓶颈，印刷与调色的前提"
    },
    {
      "key": "brightnessNit",
      "cn": "亮度",
      "unit": "nit",
      "where": "官网规格页",
      "why": "HDR 内容与户外使用"
    },
    {
      "key": "weightKg",
      "cn": "重量",
      "unit": "kg",
      "where": "官网规格页",
      "why": "便携维度的唯一硬指标"
    },
    {
      "key": "batteryWh",
      "cn": "电池容量",
      "unit": "Wh",
      "where": "详情页参数",
      "why": "续航的基础值"
    },
    {
      "key": "ports",
      "cn": "接口",
      "unit": "-",
      "where": "详情页参数",
      "why": "雷电、SD 读卡器、串口对接开发板"
    },
    {
      "key": "efficiency",
      "cn": "能效等级",
      "unit": "1/2/3 级",
      "where": "官网规格页 / 能效标识备案",
      "why": "国补家电线要求 1 级，否则一分不补"
    },
    {
      "key": "throttle",
      "cn": "持续性能衰减",
      "unit": "10 轮末/首",
      "where": "第三方循环测试（需查评测）",
      "why": "剪两小时会不会卡，参数表永远不写"
    }
  ],
