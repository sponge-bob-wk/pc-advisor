{
  "meta": {
    "version": "0.2",
    "updated": "2026-11-11",
    "purpose": "CPU 与 GPU 跑分基准表。以芯片为主键（CPU / GPU 分开），机型只存相对芯片的衰减与功耗系数。",
    "whyCpuKey": "18 台机型只有 12 个唯一 CPU。主流笔记本 CPU 约 60-120 颗，而机型有 3000 台。以 CPU 为主键，覆盖成本降一个数量级。",
    "officialFact": "Cinebench 官网不提供逐 CPU 的分数数据库，只提供软件、版本说明与命令行参数。分数一律来自第三方评测或自测。",
    "versionRule": "R23 / Cinebench 2024 / Cinebench 2026 是三套独立标尺，分数不可比、不可换算。",
    "officialQuotes": [
      "Cinebench 2026 score values are readjusted to a new range so they should not be compared to scores from previous versions of Cinebench.",
      "Compared to Cinebench R23 the computational effort for the scene increased sixfold in the multithreaded rendering test."
    ],
    "memoryGate": "Cinebench 2026 需要 6.5-8.5GB 内存加载场景；8GB 机器会走虚拟内存，性能显著下降。所以老款 8GB 轻薄本跑 2026 会失真，不能作为同代比较样本。",
    "currentBasis": "现有 438 项测试与 perf 换算全部基于 Cinebench R23。换版本必须整体迁移，不能混填。",
    "sourceOfOfficial": {
      "product": "https://www.maxon.net/en/cinebench",
      "techInfo": "https://www.maxon.net/en/tech-info-cinebench",
      "checkedAt": "2026-11-07"
    },
    "versionMatrix": {
      "geekbench": {
        "current": "Geekbench 7（2026-07-23 发布）",
        "legacy": [
          "Geekbench 6"
        ],
        "baseline": {
          "gb7": "AMD Ryzen 7 7700 = 2500 分",
          "gb6": "Intel Core i7-12700 = 2500 分"
        },
        "comparableAcrossVersions": false,
        "methodChange": "GB7 只在真实软件会多线程的任务上跑多线程；HTML5 Browser 已从多核套件移除",
        "observedShift": "单核普遍下降 9-15%（骁龙 X2 Elite -15%、M5 -14%、Intel -10%、AMD -9%）；多核有升有降（骁龙 +16%、AMD +4%、M5 +2%、Intel -2%）",
        "impactOnUs": "现有手机 perf 全部基于 GB6，锚点 4000/12000。新评测逐步迁到 GB7 后，混填会直接错，且错得自洽。"
      },
      "cinebench": {
        "generations": [
          "R23（Cinema 4D 渲染器）",
          "Cinebench 2024（Redshift）",
          "Cinebench 2026（Redshift + 统一场景 + 光追）"
        ],
        "comparableAcrossVersions": false,
        "officialQuote": "Cinebench 2026 score values are readjusted to a new range so they should not be compared to scores from previous versions",
        "loadChange": "R23 → 2026，多线程场景计算量增至 6 倍"
      },
      "3dmark": {
        "tests": [
          {
            "name": "Time Spy",
            "res": "1440p",
            "api": "DirectX 12",
            "scoreFields": [
              "graphics",
              "overall"
            ],
            "formula": "图形分 = 两段显卡测试帧率几何平均",
            "note": "存量最大（约 4800 万条结果），适合做横向对比基线"
          },
          {
            "name": "Steel Nomad",
            "res": "4K UHD",
            "api": "DX12 / Vulkan",
            "scoreFields": [
              "score"
            ],
            "formula": "平均帧率 × 100",
            "note": "Time Spy 的后继，负载约为其 3 倍"
          },
          {
            "name": "Steel Nomad Light",
            "res": "1440p",
            "api": "DX12 / Vulkan / Metal",
            "scoreFields": [
              "score"
            ],
            "formula": "平均帧率 × 135",
            "warning": "与 Steel Nomad 公式不同，两者分数绝不可混用"
          },
          {
            "name": "Port Royal",
            "res": "1440p",
            "api": "DXR",
            "scoreFields": [
              "score"
            ],
            "note": "光追专项"
          },
          {
            "name": "Speed Way",
            "res": "1440p",
            "api": "DX12 Ultimate",
            "scoreFields": [
              "score"
            ],
            "note": "DX12U 光追，最吃新架构"
          }
        ],
        "comparableAcrossTests": false
      }
    },
    "comparabilityRules": [
      "跑分四要素缺一不可：基准版本、API 或预设、功耗设置（TGP/PL1）、散热与循环条件。缺任一项即视为不可比。",
      "Geekbench 6 与 7 不可比。同一台机器单核普遍下降 9-15%，不是硬件变慢，是尺换了。",
      "Geekbench GPU 基准换 API 会差出一大截：RTX 4070 在 CUDA 下 236,094，OpenCL 163,749，差约 44%。",
      "Cinebench R23 / 2024 / 2026 三代不可比：渲染器与场景都换了。",
      "3DMark Steel Nomad 与 Steel Nomad Light 计分公式不同（×100 与 ×135），不可混用。",
      "笔记本 GPU 不可与桌面同名 GPU 比；同型号不同功耗可差 2.7 倍。",
      "必须用显卡分数（Graphics Score），不能用总分（Overall）判断 GPU——总分含 CPU 影响。"
    ],
    "tgpWarning": {
      "headline": "显卡型号名几乎不携带性能信息，功耗才携带。",
      "evidence": [
        "RTX 4070 Laptop 的 Time Spy 图形分在笔记本里从 5,012 到 13,391（35W–115W），同一型号差 2.7 倍。",
        "RTX 5060 Laptop（11,637）与 RTX 4070 Laptop（11,609）几乎打平——型号新一代，性能持平。",
        "同一台 RTX 5080 Laptop 在 120W 与 60W（静音模式）下，3DMark 分数差 30-35%。"
      ],
      "requiredField": "gpu 表必须存 tgpRangeW [min, max]，机型表必须存该机的 tgpW；只存型号无法建库。"
    },
    "cpuSpecNote": "核数与功耗取自 Intel ARK / AMD 官方 / 品牌官网；cores 可用于多核权重建模。",
    "cpuCount": 36
  },
  "methods": {
    "selfTest": {
      "why": "第三方评测的条件（功耗模式、室温、是否插电、是否循环）往往不写清，抄来的分数无法复现。自测能固定条件、可重复。",
      "cli": {
        "all": "Cinebench.exe g_CinebenchAllTests=true",
        "single": "Cinebench.exe g_CinebenchCpu1Test=true",
        "smt": "Cinebench.exe g_CinebenchCpuSMTTest=true",
        "multi": "Cinebench.exe g_CinebenchCpuXTest=true",
        "duration": "g_CinebenchMinimumTestDuration=100"
      },
      "conditions": [
        "插电、高性能电源模式",
        "关机重启后静置 5 分钟再测（清后台）",
        "记录室温",
        "单核与多核分开记录",
        "连跑 10 轮，记录首轮与末轮 → 得到衰减系数"
      ]
    },
    "sourceTiers": [
      {
        "tier": 1,
        "name": "自测",
        "trust": "最高",
        "note": "条件可控、可复现"
      },
      {
        "tier": 2,
        "name": "第三方评测",
        "trust": "中",
        "note": "必须记下测试条件；同一 CPU 多个来源取中位数"
      },
      {
        "tier": 3,
        "name": "厂商宣传稿",
        "trust": "不可用",
        "note": "条件不透明，只用于发现型号，不用于取数"
      }
    ]
  },
